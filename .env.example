# ==========================================
# CARTY - Environment Variables (Example)
# העתיקו קובץ זה לקובץ בשם .env ומלאו את הערכים האמיתיים.
# אסור להעלות את הקובץ .env ל-Git!
# ==========================================

# Supabase Project Settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_KEY

# Optional: Gemini AI API Key (לשימוש עתידי בספרינטים)
GEMINI_API_KEY=

# Frontend -> Backend connection
VITE_API_URL=http://localhost:8000
